# Copy to .env.local and fill in values from the certnest-dev project
# (Supabase Dashboard -> Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used in auth email links (must be in Supabase Auth Redirect URLs).
SITE_URL=http://localhost:3000

# Server-only. Never add a NEXT_PUBLIC_ prefix, never import from client code.
# Use the secret key (sb_secret_...) or the legacy service_role key, not the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# AI post drafts (server-only). Development uses Gemini's free tier
# (key from https://aistudio.google.com). Its prompts may be used by Google,
# so only use test data, and switch to a paid provider before launch.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-lite-latest (falls back to gemini-flash-latest).
GEMINI_MODEL=
# Production refuses Gemini unless this is true (only with a paid key).
AI_ALLOW_GEMINI_IN_PRODUCTION=false

# Tests refuse to run unless NEXT_PUBLIC_SUPABASE_URL points at this project.
CERTNEST_DEV_PROJECT_REF=wvoffnlgxdrbzoziexvt
