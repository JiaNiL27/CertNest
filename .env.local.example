# Copy to .env.local and fill in values from the certnest-dev project
# (Supabase Dashboard -> Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used in auth email links (must be in Supabase Auth Redirect URLs).
SITE_URL=http://localhost:3000

# Server-only. Never add a NEXT_PUBLIC_ prefix, never import from client code.
# Use the secret key (sb_secret_...) or the legacy service_role key, not the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Tests refuse to run unless NEXT_PUBLIC_SUPABASE_URL points at this project.
CERTNEST_DEV_PROJECT_REF=wvoffnlgxdrbzoziexvt
